@page
@model TeamSchedule.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = "變更密碼";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="app-card p-4 p-md-5 shadow-sm">
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div class="brand-mark" style="width: 2.75rem; height: 2.75rem; font-size: 1.35rem;">
            <i class="bi bi-key"></i>
        </div>
        <div>
            <h3 class="fw-bold section-title h4 mb-0">變更帳號密碼</h3>
            <p class="text-muted small mb-0">請輸入目前舊密碼與設定新密碼</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form id="change-password-form" method="post">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3" role="alert"></div>
        }

        <div class="form-floating mb-3">
            <input asp-for="Input.OldPassword" class="form-control rounded-3" autocomplete="current-password" aria-required="true"/>
            <label asp-for="Input.OldPassword" class="text-secondary"><i class="bi bi-shield-lock me-1"></i>目前舊密碼</label>
            <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Input.NewPassword" class="form-control rounded-3" autocomplete="new-password" aria-required="true"/>
            <label asp-for="Input.NewPassword" class="text-secondary"><i class="bi bi-lock me-1"></i>設定新密碼 (至少 6 碼)</label>
            <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
        </div>

        <div class="form-floating mb-4">
            <input asp-for="Input.ConfirmPassword" class="form-control rounded-3" autocomplete="new-password" aria-required="true"/>
            <label asp-for="Input.ConfirmPassword" class="text-secondary"><i class="bi bi-check2-square me-1"></i>確認新密碼</label>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-app-primary rounded-pill px-4 fw-bold">
            <i class="bi bi-check-circle me-1"></i> 更新密碼
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
