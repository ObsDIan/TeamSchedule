@page
@model TeamSchedule.Areas.Identity.Pages.Account.Manage.PersonalDataModel
@{
    ViewData["Title"] = "個人資料與隱私";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="app-card p-4 p-md-5 shadow-sm">
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div class="brand-mark" style="width: 2.75rem; height: 2.75rem; font-size: 1.35rem;">
            <i class="bi bi-shield-check"></i>
        </div>
        <div>
            <h3 class="fw-bold section-title h4 mb-0">個人資料與隱私安全</h3>
            <p class="text-muted small mb-0">管理您的個人帳號隱私權與資料隱私</p>
        </div>
    </div>

    <div class="alert alert-info rounded-3 mb-4">
        <i class="bi bi-info-circle me-1"></i>
        您的帳號包含您提供給 TeamSchedule 的個人資料。此頁面允許您瞭解或刪除這些資料。
    </div>

    <p class="text-secondary mb-4">
        <strong>注意：</strong> 刪除帳號將會永久刪除您在 TeamSchedule 中的個人設定，且此動作無法還原。
    </p>

    <div class="d-flex gap-3">
        <a id="delete" asp-page="./DeletePersonalData" class="btn btn-outline-danger rounded-pill px-4 fw-bold">
            <i class="bi bi-trash me-1"></i> 刪除我的個人帳號
        </a>
    </div>
</div>
