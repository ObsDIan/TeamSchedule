@page
@model TeamSchedule.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "個人帳號設定";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="app-card p-4 p-md-5 shadow-sm">
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="brand-mark" style="width: 3rem; height: 3rem; font-size: 1.5rem;">
                        <i class="bi bi-person-gear"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold section-title mb-1">個人資料管理</h2>
                        <p class="text-muted small mb-0">更新您的帳號顯示名稱與基本資料</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                        @Model.StatusMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form id="profile-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input value="@Model.Username" class="form-control rounded-3" disabled />
                        <label class="text-secondary"><i class="bi bi-envelope me-1"></i>帳號 (Email)</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.DisplayName" class="form-control rounded-3" placeholder="小明" />
                        <label asp-for="Input.DisplayName" class="text-secondary"><i class="bi bi-person-badge me-1"></i>顯示名稱 (暱稱)</label>
                        <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.PhoneNumber" class="form-control rounded-3" placeholder="0912345678" />
                        <label asp-for="Input.PhoneNumber" class="text-secondary"><i class="bi bi-telephone me-1"></i>電話號碼 (可選)</label>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-3">
                        <button id="update-profile-button" type="submit" class="btn btn-app-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-check-circle me-1"></i> 儲存變更
                        </button>
                        <a asp-page="./ChangePassword" class="btn btn-app-secondary rounded-pill px-4 fw-semibold">
                            <i class="bi bi-key me-1"></i> 變更密碼
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
