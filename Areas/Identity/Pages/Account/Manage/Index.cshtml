@page
@model TeamSchedule.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "個人資料與暱稱";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="app-card p-4 p-md-5 shadow-sm">
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div class="brand-mark" style="width: 2.75rem; height: 2.75rem; font-size: 1.35rem;">
            <i class="bi bi-person-badge"></i>
        </div>
        <div>
            <h3 class="fw-bold section-title h4 mb-0">基本資料與暱稱修改</h3>
            <p class="text-muted small mb-0">團隊成員將會在月曆與投票矩陣中看到您的顯示名稱</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form id="profile-form" method="post">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3" role="alert"></div>
        }

        <div class="form-floating mb-3">
            <input value="@Model.Username" class="form-control rounded-3" disabled />
            <label class="text-secondary"><i class="bi bi-envelope me-1"></i>帳號 (Email)</label>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Input.DisplayName" class="form-control rounded-3"/>
            <label asp-for="Input.DisplayName" class="text-secondary"><i class="bi bi-person-badge me-1"></i>顯示名稱 (暱稱)</label>
            <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
        </div>

        <div class="form-floating mb-4">
            <input asp-for="Input.PhoneNumber" class="form-control rounded-3"/>
            <label asp-for="Input.PhoneNumber" class="text-secondary"><i class="bi bi-telephone me-1"></i>電話號碼 (可選)</label>
            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-3">
            <button id="update-profile-button" type="submit" class="btn btn-app-primary rounded-pill px-4 fw-bold">
                <i class="bi bi-check-circle me-1"></i> 儲存變更
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
