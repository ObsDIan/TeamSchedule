@page
@model TeamSchedule.Areas.Identity.Pages.Account.Manage.EmailModel
@{
    ViewData["Title"] = "Email 設定";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="app-card p-4 p-md-5 shadow-sm">
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div class="brand-mark" style="width: 2.75rem; height: 2.75rem; font-size: 1.35rem;">
            <i class="bi bi-envelope"></i>
        </div>
        <div>
            <h3 class="fw-bold section-title h4 mb-0">Email 電子郵件與登入帳號</h3>
            <p class="text-muted small mb-0">更新您的聯絡與登入用電子郵件地址</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form id="email-form" asp-page-handler="ChangeEmail" method="post">
        <div asp-validation-summary="All" class="alert alert-danger rounded-3 small mb-3" role="alert"></div>

        <div class="form-floating mb-3">
            <input value="@Model.Email" class="form-control rounded-3" disabled />
            <label class="text-secondary"><i class="bi bi-envelope-check me-1"></i>目前 Email</label>
        </div>

        <div class="form-floating mb-4">
            <input asp-for="Input.NewEmail" class="form-control rounded-3" placeholder="newemail@example.com" />
            <label asp-for="Input.NewEmail" class="text-secondary"><i class="bi bi-envelope-plus me-1"></i>新 Email 電子郵件</label>
            <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
        </div>

        <button id="change-email-button" type="submit" class="btn btn-app-primary rounded-pill px-4 fw-bold">
            <i class="bi bi-check-circle me-1"></i> 更新 Email 帳號
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
