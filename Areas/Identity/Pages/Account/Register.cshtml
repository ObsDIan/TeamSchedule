@page
@model TeamSchedule.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "免費註冊帳號";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="app-card p-4 p-md-5 shadow-md">
                <div class="text-center mb-4">
                    <div class="brand-mark mx-auto mb-3" style="width: 3.5rem; height: 3.5rem; font-size: 1.75rem;">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <h2 class="fw-bold section-title mb-1">建立新帳號</h2>
                    <p class="text-muted small">加入 TeamSchedule，輕鬆搞定團隊活動時間排程</p>
                </div>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3" role="alert"></div>
                    }

                    <div class="form-floating mb-3">
                        <input asp-for="Input.DisplayName" class="form-control rounded-3" placeholder="小明" aria-required="true" />
                        <label asp-for="Input.DisplayName" class="text-secondary"><i class="bi bi-person-badge me-1"></i>顯示名稱 (暱稱)</label>
                        <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="text-secondary"><i class="bi bi-envelope me-1"></i>Email 電子郵件</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="text-secondary"><i class="bi bi-lock me-1"></i>設定密碼 (至少 6 碼)</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.ConfirmPassword" class="text-secondary"><i class="bi bi-shield-check me-1"></i>確認密碼</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-app-primary rounded-pill fw-bold py-2 shadow-sm mb-3">
                        <i class="bi bi-check-circle me-1"></i> 完成註冊並登入
                    </button>

                    <div class="text-center pt-3 border-top">
                        <span class="text-muted small">已有帳號？</span>
                        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-decoration-none ms-1">
                            直接登入 <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
