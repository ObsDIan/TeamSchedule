@page
@model TeamSchedule.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "會員登入";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="app-card p-4 p-md-5 shadow-md">
                <div class="text-center mb-4">
                    <div class="brand-mark mx-auto mb-3" style="width: 3.5rem; height: 3.5rem; font-size: 1.75rem;">
                        <i class="bi bi-box-arrow-in-right"></i>
                    </div>
                    <h2 class="fw-bold section-title mb-1">歡迎回來</h2>
                    <p class="text-muted small">登入 TeamSchedule 開始安排與檢視團隊空檔</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="text-secondary"><i class="bi bi-envelope me-1"></i>Email 電子郵件</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="text-secondary"><i class="bi bi-lock me-1"></i>密碼</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label small text-secondary" asp-for="Input.RememberMe">
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-app-primary rounded-pill fw-bold py-2 shadow-sm mb-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i> 登入系統
                    </button>

                    <div class="text-center pt-3 border-top">
                        <span class="text-muted small">還沒有帳號嗎？</span>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-decoration-none ms-1">
                            立即免費註冊 <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
