@model TeamSchedule.ViewModels.WeeklySetupViewModel
@using TeamSchedule.Models
@{
    ViewData["Title"] = "設定每週預設狀態";
}

<div class="container py-4" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">⚙️ 設定每週預設狀態</h2>
            <p class="text-muted mb-0">設定您每週固定的可用規律，無特殊日期的日子將自動套用此設定。</p>
        </div>
        <a asp-action="Calendar" class="btn btn-outline-secondary rounded-pill px-4">
            &laquo; 返回個人月曆
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            ✅ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 快速預設按鈕 -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">⚡ 快速一鍵設定</h5>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-primary rounded-pill px-3" onclick="applyPreset('weekdayBusy')">
                    💼 平日忙碌、假日有空 (預設推薦)
                </button>
                <button type="button" class="btn btn-outline-success rounded-pill px-3" onclick="applyPreset('allAvailable')">
                    🟢 全週有空
                </button>
                <button type="button" class="btn btn-outline-danger rounded-pill px-3" onclick="applyPreset('allBusy')">
                    🔴 全週忙碌
                </button>
            </div>
        </div>
    </div>

    <!-- 表單 -->
    <form asp-action="WeeklySetup" method="post">
        @Html.AntiForgeryToken()

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">星期一至星期日預設值</h5>

                <div class="list-group list-group-flush">
                    @foreach (var kvp in TeamSchedule.ViewModels.WeeklySetupViewModel.DayOfWeekNames)
                    {
                        int dayKey = kvp.Key;
                        string dayName = kvp.Value;
                        var currentVal = Model.DaySettings.ContainsKey(dayKey) ? Model.DaySettings[dayKey] : AvailabilityStatus.Available;

                        <div class="list-group-item px-0 py-3 d-flex align-items-center justify-content-between">
                            <span class="fw-bold fs-6">@dayName</span>
                            <div class="d-flex gap-2">
                                <select name="DaySettings[@dayKey]" class="form-select rounded-pill px-3 select-day" data-day="@dayKey">
                                    <option value="1" selected="@(currentVal == AvailabilityStatus.Available)">🟢 有空 (Available)</option>
                                    <option value="2" selected="@(currentVal == AvailabilityStatus.Busy)">🔴 忙碌 (Busy)</option>
                                    <option value="3" selected="@(currentVal == AvailabilityStatus.Maybe)">🟡 不確定 (Maybe)</option>
                                </select>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3">
            <a asp-action="Calendar" class="btn btn-light rounded-pill px-4">取消</a>
            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold fs-6">儲存每週設定</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function applyPreset(type) {
            const selects = document.querySelectorAll('.select-day');
            selects.forEach(select => {
                const day = parseInt(select.getAttribute('data-day'));
                if (type === 'weekdayBusy') {
                    // Mon-Fri (1-5) Busy, Sat(6) & Sun(0) Available
                    if (day >= 1 && day <= 5) {
                        select.value = '2'; // Busy
                    } else {
                        select.value = '1'; // Available
                    }
                } else if (type === 'allAvailable') {
                    select.value = '1';
                } else if (type === 'allBusy') {
                    select.value = '2';
                }
            });
        }
    </script>
}
