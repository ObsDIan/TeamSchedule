@using Microsoft.AspNetCore.Identity
@using TeamSchedule.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ApplicationUser? user = null;
    if (SignInManager.IsSignedIn(User))
    {
        user = await UserManager.GetUserAsync(User);
    }
}

<ul class="navbar-nav align-items-lg-center gap-2">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link fw-semibold px-2" asp-area="Identity" asp-page="/Account/Manage/Index" title="個人帳號與暱稱管理">
            <i class="bi bi-person-circle me-1 text-primary"></i>@(user?.DisplayName ?? User.Identity?.Name ?? "會員")
        </a>
    </li>
    <li class="nav-item">
        <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                <i class="bi bi-box-arrow-right me-1"></i>登出
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-app-secondary btn-sm rounded-pill px-3 fw-semibold" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>登入
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-app-primary btn-sm rounded-pill px-3 fw-semibold" asp-area="Identity" asp-page="/Account/Register">
            <i class="bi bi-person-plus me-1"></i>註冊
        </a>
    </li>
}
</ul>
