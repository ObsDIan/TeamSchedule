@model TeamSchedule.ViewModels.TeamDetailViewModel
@using TeamSchedule.Models
@{
    ViewData["Title"] = Model.TeamName + " - 團隊 Dashboard";
    var prevMonth = new DateTime(Model.Calendar.Year, Model.Calendar.Month, 1).AddMonths(-1);
    var nextMonth = new DateTime(Model.Calendar.Year, Model.Calendar.Month, 1).AddMonths(1);
}

<style>
    .team-calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
    }

    .team-calendar-day-header {
        text-align: center;
        font-weight: 600;
        padding: 10px;
        background: rgba(248, 249, 250, 0.8);
        border-radius: 8px;
        color: #495057;
    }

    .team-calendar-day-card {
        min-height: 120px;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 8px;
        position: relative;
        overflow: hidden;
        background-color: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        z-index: 1;
    }

    /* 4 色由下而上百分比填滿容器 */
    .calendar-fill-container {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        z-index: -1;
        opacity: 0.85;
    }

    .fill-segment {
        width: 100%;
        transition: height 0.3s ease;
    }

    .fill-available {
        background-color: rgba(25, 135, 84, 0.35);
    }

    .fill-maybe {
        background-color: rgba(255, 193, 7, 0.35);
    }

    .fill-busy {
        background-color: rgba(220, 53, 69, 0.35);
    }

    .fill-unset {
        background-color: rgba(108, 117, 125, 0.15);
    }

    /* 深色模式調色 */
    [data-bs-theme="dark"] .fill-available {
        background-color: rgba(16, 185, 129, 0.3);
    }

    [data-bs-theme="dark"] .fill-maybe {
        background-color: rgba(245, 158, 11, 0.3);
    }

    [data-bs-theme="dark"] .fill-busy {
        background-color: rgba(239, 68, 68, 0.3);
    }

    [data-bs-theme="dark"] .fill-unset {
        background-color: rgba(71, 85, 105, 0.2);
    }

    .team-calendar-day-card.other-month {
        opacity: 0.35;
    }

    .team-calendar-day-card.today {
        border: 2px solid #4f46e5 !important;
    }

    .candidate-flag {
        font-size: 0.75rem;
        background-color: #6366f1;
        color: white;
        padding: 2px 6px;
        border-radius: 6px;
        font-weight: bold;
    }
</style>

<div class="container py-4">
    <!-- Header info -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="fw-bold text-dark mb-0">👥 @Model.TeamName</h2>
                        @if (Model.IsOwner)
                        {
                            <span class="badge bg-primary rounded-pill">團隊管理者</span>
                        }
                    </div>
                    <p class="text-muted mb-0">@(string.IsNullOrEmpty(Model.Description) ? "未設定說明" : Model.Description)</p>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div class="p-2 px-3 bg-body-tertiary rounded-3 text-center">
                        <small class="text-muted d-block">邀請碼 (可分享)</small>
                        <strong class="text-primary font-monospace fs-5">@Model.InviteCode</strong>
                    </div>
                    <a asp-action="CreateActivity" asp-route-teamId="@Model.TeamId" class="btn btn-success rounded-pill px-4">
                        ➕ 建立團隊活動
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            ✅ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- 左側：團隊 4 色比例累積月曆 (佔 8 欄) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0">📊 團隊空檔累積月曆</h4>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-action="Detail" asp-route-id="@Model.TeamId" asp-route-year="@prevMonth.Year" asp-route-month="@prevMonth.Month" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            &laquo; @prevMonth.Month 月
                        </a>
                        <h5 class="fw-bold mb-0 mx-2 text-primary">@Model.Calendar.MonthTitle</h5>
                        <a asp-action="Detail" asp-route-id="@Model.TeamId" asp-route-year="@nextMonth.Year" asp-route-month="@nextMonth.Month" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            @nextMonth.Month 月 &raquo;
                        </a>
                    </div>
                </div>

                <!-- 填充圖例 -->
                <div class="d-flex flex-wrap gap-3 mb-3 p-2 bg-body-tertiary rounded-3 small">
                    <span class="fw-bold">填充高度代表團隊比例：</span>
                    <span><strong class="text-success">🟩 有空 (@Model.Calendar.Days.Max(d => d.AvailableCount))</strong></span>
                    <span><strong class="text-warning">🟨 不確定</strong></span>
                    <span><strong class="text-danger">🟥 忙碌</strong></span>
                    <span><strong class="text-secondary">⬜ 未設定</strong></span>
                    <span class="ms-auto">總人數：<strong>@Model.Calendar.TotalMembersCount 人</strong></span>
                </div>

                <div class="team-calendar-grid mb-2">
                    <div class="team-calendar-day-header text-danger">週日</div>
                    <div class="team-calendar-day-header">週一</div>
                    <div class="team-calendar-day-header">週二</div>
                    <div class="team-calendar-day-header">週三</div>
                    <div class="team-calendar-day-header">週四</div>
                    <div class="team-calendar-day-header">週五</div>
                    <div class="team-calendar-day-header text-primary">週六</div>
                </div>

                <div class="team-calendar-grid">
                    @foreach (var day in Model.Calendar.Days)
                    {
                        var isOther = !day.IsCurrentMonth ? "other-month" : "";
                        var isToday = day.IsToday ? "today" : "";

                        <div class="team-calendar-day-card hover-lift shadow-sm @isOther @isToday">
                            <!-- 4 色由下而上動態比例填充背景 -->
                            <div class="calendar-fill-container">
                                <div class="fill-segment fill-unset" style="height: @day.UnsetPercent%;"></div>
                                <div class="fill-segment fill-busy" style="height: @day.BusyPercent%;"></div>
                                <div class="fill-segment fill-maybe" style="height: @day.MaybePercent%;"></div>
                                <div class="fill-segment fill-available" style="height: @day.AvailablePercent%;"></div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold fs-6">@day.Date.Day</span>
                                @if (day.IsConfirmedDate)
                                {
                                    <span class="badge bg-success" title="此日期有已確認的活動">🎉 已定案</span>
                                }
                                else if (day.IsCandidateDate)
                                {
                                    <span class="candidate-flag" title="此日期為進行中活動候選日期">📍 候選</span>
                                }
                            </div>

                            <div class="mt-2">
                                <div class="small fw-bold">
                                    <span class="text-success">🟢 @day.AvailableCount</span>
                                    <span class="text-danger ms-1">🔴 @day.BusyCount</span>
                                    <span class="text-warning ms-1">🟡 @day.MaybeCount</span>
                                </div>

                                @if (day.ActivityId.HasValue)
                                {
                                    var badgeBg = day.IsConfirmedDate ? "bg-success" : "bg-primary";
                                    <a asp-action="ActivityDetail" asp-route-id="@day.ActivityId" class="badge @badgeBg text-decoration-none mt-1 text-truncate d-block" title="@day.ActivityTitle">
                                        👉 @day.ActivityTitle
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 右側：活動與成員列表 (佔 4 欄) -->
        <div class="col-lg-4">
            <!-- 進行中活動 -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">📌 進行中活動排程</h5>
                    @if (!Model.OngoingActivities.Any())
                    {
                        <p class="text-muted small mb-0">目前沒有進行中的活動調查。</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var act in Model.OngoingActivities)
                            {
                                <a asp-action="ActivityDetail" asp-route-id="@act.ActivityId" class="list-group-item list-group-item-action px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold text-primary mb-1">@act.Title</h6>
                                        <span class="badge bg-warning text-dark rounded-pill">回覆調查中</span>
                                    </div>
                                    <small class="text-muted">候選日期數：@act.CandidateDatesCount 天</small>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 已確認活動 -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">🎉 已確認的活動</h5>
                    @if (!Model.ConfirmedActivities.Any())
                    {
                        <p class="text-muted small mb-0">尚無已定案的活動。</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var act in Model.ConfirmedActivities)
                            {
                                <a asp-action="ActivityDetail" asp-route-id="@act.ActivityId" class="list-group-item list-group-item-action px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold text-success mb-1">@act.Title</h6>
                                        <span class="badge bg-success rounded-pill">已定案</span>
                                    </div>
                                    <small class="text-dark fw-bold">日期：@act.FinalDate?.ToString("yyyy-MM-dd (ddd)")</small>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 成員名單 -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">👥 成員列表 (@Model.Members.Count 人)</h5>
                    <div class="list-group list-group-flush">
                        @foreach (var mem in Model.Members)
                        {
                            <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                <div>
                                    <strong class="d-block">@mem.DisplayName</strong>
                                    <small class="text-muted">@mem.Email</small>
                                </div>
                                @if (mem.Role == TeamRole.Owner)
                                {
                                    <span class="badge bg-primary rounded-pill">管理者</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark rounded-pill">成員</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
